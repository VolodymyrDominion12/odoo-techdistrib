<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Групи доступу (security groups)
     =========================================================================
     Права в Odoo тримаються на ДВОХ стовпах, і обидва обов'язкові:

     1. МОДЕЛЬНІ ПРАВА (ir.model.access) — «чи можна взагалі чіпати цю
        таблицю». Вони грубі: read / write / create / unlink для всієї моделі.
        Задаються в ir.model.access.csv.

     2. ЗАПИСОВІ ПРАВА (ir.rule) — «які саме РЯДКИ цієї таблиці видно».
        Вони тонкі: `[('user_id', '=', user.id)]`. Задаються в XML через
        <record model="ir.rule">.

     Групи нижче — це «ролі». Користувач може мати кілька груп одночасно,
     і тоді права СКЛАДАЮТЬСЯ (union), а не перетинаються.

     ВАЖЛИВО: файл з групами має читатись ПЕРЕД ir.model.access.csv,
     бо CSV посилається на ці групи за XML ID.
     ========================================================================= -->
<odoo>

    <!-- Категорія групи. Це лише «полиця» на екрані вибору прав доступу,
         але вона робить інтерфейс адміністрування зрозумілим. -->
    <record id="module_category_techdistrib" model="ir.module.category">
        <field name="name">TechDistrib</field>
        <field name="description">Дилерська програма та кредитна політика</field>
        <field name="sequence">20</field>
    </record>

    <!-- Звичайний користувач дилерської програми: може ДИВИТИСЬ рівні дилерів,
         але не може їх змінювати (це привілей керівника). -->
    <record id="group_dealer_user" model="res.groups">
        <field name="name">Дилерська програма / Користувач</field>
        <field name="category_id" ref="module_category_techdistrib"/>
        <!-- implied_ids — «успадковані» групи: хто отримує цю групу,
             автоматично отримує й ці. base.group_user = внутрішній
             користувач (доступ до бек-офісу). Без нього група була б
             марною: користувач не зміг би зайти в систему.
             Синтаксис (4, ref(...)) — «додати зв'язок» у Many2many. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Керівник: може змінювати рівні дилерів і правила програми. -->
    <record id="group_dealer_manager" model="res.groups">
        <field name="name">Дилерська програма / Керівник</field>
        <field name="category_id" ref="module_category_techdistrib"/>
        <!-- Керівник автоматично отримує права користувача -->
        <field name="implied_ids" eval="[(4, ref('group_dealer_user'))]"/>
    </record>

    <!-- =====================================================================
         ЗАПИСОВЕ ПРАВИЛО (ir.rule): хто які рядки бачить
         =====================================================================
         Це найважливіший приклад того, як Odoo розділяє «права на модель»
         і «права на дані».

         Уявімо, що ми хочемо: менеджер із продажу бачить лише СВОЇХ дилерів,
         а керівник дилерської програми — усіх.

         Зверни увагу на конструкцію domain_force — це домен Odoo, у якому
         доступні змінні:
             user   — поточний користувач (res.users)
             company_id / company_ids — компанії користувача
             time   — поточна дата (можна писати time.strftime('%Y-%m-%d'))

         ⚠️ ПРАВИЛО НИЖЧЕ НАВМИСНО ЗАКОМЕНТОВАНО.
         Якщо його увімкнути зараз, воно застосується до ВСІХ партнерів
         (не лише до дилерів!) і зламає видимість клієнтів у продажах.
         Правила на res.partner — дуже небезпечні, бо цю модель
         використовує вся система.

         Щоб увімкнути — розкоментуй і додай у domain умову is_dealer,
         а також переконайся, що `user_id` (менеджер) справді заповнюється.
         ===================================================================== -->
    <!--
    <record id="rule_dealer_own_only" model="ir.rule">
        <field name="name">Дилер: менеджер бачить лише своїх</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">
            ['|', ('is_dealer', '=', False),
                  ('user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_dealer_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    -->

</odoo>
