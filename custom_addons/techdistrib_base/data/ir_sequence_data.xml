<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Послідовність (ir.sequence) для кодів дилерів
     =========================================================================
     noupdate="1" — НАЙВАЖЛИВІШИЙ атрибут цього файлу.

     Без нього при кожному оновленні модуля (`-u`) Odoo перезапише запис
     початковими значеннями. Для довідника це зазвичай нормально, але для
     ЛІЧИЛЬНИКА це катастрофа: номер повернеться до початкового, і новий
     дилер отримає код, який уже виданий іншому → помилка унікальності.

     Правило: noupdate="1" ставлять на все, що користувач може змінити
     або що накопичує стан (послідовності, шаблони друку, налаштування).
     ========================================================================= -->
<odoo noupdate="1">

    <record id="seq_techdistrib_dealer" model="ir.sequence">
        <field name="name">Код дилера</field>
        <!-- code — це те, за чим ми звертаємось із Python:
             env['ir.sequence'].next_by_code('techdistrib.dealer') -->
        <field name="code">techdistrib.dealer</field>
        <field name="prefix">DLR-</field>
        <!-- padding=5 означає, що номер буде доповнений нулями до 5 знаків:
             1 → DLR-00001, 42 → DLR-00042 -->
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        <field name="implementation">standard</field>
    </record>

</odoo>
