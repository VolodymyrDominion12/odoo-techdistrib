<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Запланована задача (cron): оновлення статусів дилерів
     =========================================================================
     Це стандартний механізм автоматизації Odoo. Працює так:
       * у базі є таблиця ir_cron із задачами;
       * головний процес Odoo раз на хвилину перевіряє, чия черга настала;
       * якщо настала — виконує поле `code` у контексті моделі з `model_id`.
       * змінна `model` у коді — це recordset відповідної моделі,
         а `env` — середовище.

     ⚠️ ГОЛОВНА ПАСТКА CRON У ODOO: у багатопроцесному режимі
     (workers > 0) кожен воркер має свій планувальник. Odoo захищає від
     подвійного запуску через advisory locks у Postgres — але твоя задача
     все одно має бути ІДЕМПОТЕНТНОЮ: повторний запуск не повинен
     завдавати шкоди. Наш код це виконує: він знижує рівень рівно на один
     щабель і пропускає тих, хто вже на найнижчому.

     У нас workers = 0 (режим розробки), тому cron працює прямо
     в основному процесі.
     ========================================================================= -->
<odoo>

    <record id="ir_cron_techdistrib_update_dealer_status" model="ir.cron">
        <field name="name">TechDistrib: оновлення статусів дилерів</field>
        <!-- model_id вказує, на якій моделі виконувати код.
             XML ID моделі формується як model_<назва_з_підкресленнями>. -->
        <field name="model_id" ref="base.model_res_partner"/>
        <!-- state='code' означає «виконати Python-код із поля code».
             Альтернатива — state='object': тоді в полі code пишеться
             назва методу, а Odoo викликає його напряму. -->
        <field name="state">code</field>
        <!-- `model` тут — це res.partner (порожній recordset) -->
        <field name="code">model._cron_update_dealer_status()</field>
        <!-- Періодичність: раз на добу. Для бізнес-правила «6 місяців без
             покупок» частіше не потрібно, а щохвилини — марна робота. -->
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- ⚠️ УВАГА, ХТО ПЕРЕНОСИТЬ КОД З ODOO 17:
             Тут були поля numbercall і doall. У Odoo 18 їх ВИДАЛЕНО.
             Якщо скопіювати cron із туторіалу під 16/17, отримаєш
             незрозумілу ParseError «Invalid field ir.cron.numbercall».
             Перевірити, які поля існують, можна так:
                 grep "= fields\." vendor/odoo/odoo/addons/base/models/ir_cron.py
             Це найшвидший спосіб дізнатись правду про будь-яку модель. -->
        <field name="active" eval="True"/>
        <!-- Задаємо користувача, від імені якого виконується задача.
             Важливо, якщо в коді є перевірки прав: cron від імені
             адміністратора побачить усі записи. -->
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
