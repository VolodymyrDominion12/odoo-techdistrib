        <field name="categ_id" ref="product_category_network"/>
        <field name="discount">18.0</field>
    </record>
    <record id="matrix_gold_iot" model="techdistrib.discount.matrix">
        <field name="tier_id" ref="techdistrib_base.dealer_tier_gold"/>
        <field name="categ_id" ref="product_category_iot"/>
        <field name="discount">17.0</field>
    </record>
    <record id="matrix_gold_accessories" model="techdistrib.discount.matrix">
