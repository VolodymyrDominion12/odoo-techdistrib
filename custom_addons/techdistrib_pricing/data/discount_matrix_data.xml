    <!-- =====================================================================
         Ліміти ручних знижок (FR-B04)

         ⚠️ Це <function>, а не <record>, і ось чому.

         Рівні створює модуль techdistrib_base з noupdate="1". Отже, Odoo
         БІЛЬШЕ НЕ ОНОВЛЮЄ ці записи з data-файлів — щоб правки бізнесу
         не затирались при оновленні модуля.

         Тому звичайний <record id="techdistrib_base.dealer_tier_gold">
         з полем max_manual_discount ПРОСТО НЕ ЗАСТОСУВАВСЯ Б:
         Odoo побачив би, що запис позначений noupdate, і пропустив оновлення.

         <function> викликає Python-метод ПОЗА цим механізмом.
         Метод _setup_default_discount_limits ідемпотентний: він ставить
         ліміт лише якщо той ще нульовий, тож повторне оновлення модуля
         не загубить налаштувань адміністратора.
         ===================================================================== -->
    <function model="techdistrib.dealer.tier"
              name="_setup_default_discount_limits"/>

</odoo>
