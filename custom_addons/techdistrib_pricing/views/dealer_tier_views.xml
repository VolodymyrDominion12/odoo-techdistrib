<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Розширення форми рівня партнера: матриця, прайс-лист, ліміт
     ========================================================================= -->
<odoo>

    <record id="view_dealer_tier_form_techdistrib_pricing" model="ir.ui.view">
        <field name="name">techdistrib.dealer.tier.form.pricing</field>
        <field name="model">techdistrib.dealer.tier</field>
        <field name="inherit_id" ref="techdistrib_base.view_techdistrib_dealer_tier_form"/>
        <field name="arch" type="xml">

            <!-- Smart-кнопка «Матриця знижок» -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_matrix"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent">
                    <field name="matrix_count" widget="statinfo" string="Знижок"/>
                </button>
            </xpath>

            <!-- Поля керування знижками у групі «Параметри» -->
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="max_manual_discount" widget="percentage"/>
                <field name="pricelist_id"
                       readonly="1"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- Нова вкладка «Матриця знижок» — ПЕРШОЮ в notebook,
                 бо це найважливіше для роботи з рівнем. -->
            <xpath expr="//page[@name='description']" position="before">
                <page string="Матриця знижок" name="matrix">
                    <field name="matrix_ids" editable="bottom">
                        <list string="Знижки рівня">
                            <field name="categ_id"/>
                            <field name="discount" widget="percentage"/>
                            <field name="pricelist_item_id" optional="hide"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <div class="mt-3">
                        <button name="action_regenerate_pricelist"
                                type="object"
                                string="Перебудувати прайс-лист"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                        <button name="action_open_pricelist"
                                type="object"
                                string="Відкрити прайс-лист"
                                class="btn-link"
                                icon="fa-external-link"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
