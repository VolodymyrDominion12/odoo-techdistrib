<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Cron: автоматичне створення нарахувань ретро-бонусів
     =========================================================================
     Задача запускається ЩОДНЯ, але створює нарахування лише тоді, коли
     їх ще немає. Це стандартний підхід для періодичних задач:

       «Перевіряй щодня, чи настав момент, і роби лише те, чого бракує.»

     Альтернатива — запускати раз на квартал у конкретну дату. Вона гірша:
     якщо сервер у той день лежав, нарахування не створиться зовсім.
     А щоденна ідемпотентна перевірка «наздожене» пропущене.

     Це принцип «самолікування» розкладу: задача має доганяти пропущене,
     а не втрачати його назавжди.
     ========================================================================= -->
<odoo>

    <record id="ir_cron_techdistrib_vendor_rebates" model="ir.cron">
        <field name="name">TechDistrib: нарахування ретро-бонусів вендорів</field>
        <field name="model_id" ref="model_techdistrib_vendor_rebate"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_quarterly_rebates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
