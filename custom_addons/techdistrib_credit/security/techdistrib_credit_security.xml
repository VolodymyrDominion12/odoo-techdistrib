<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     Групи доступу та правила записів кредитної політики
     ========================================================================= -->
<odoo>

    <!-- =====================================================================
         1. ГРУПА: КРЕДИТНИЙ КОНТРОЛЕР
         =====================================================================
         Єдина роль, яка має право:
           * схвалювати запити на перевищення ліміту;
           * відхиляти їх із обґрунтуванням;
           * змінювати кредитний ліміт дилера.

         ⚠️ ЧОМУ ГРУПА УСПАДКОВУЄ БУХГАЛТЕРСЬКУ ГРУПУ — важлива деталь.

         Подивись, як оголошено стандартне поле (addons/account/models/partner.py):

             credit_limit = fields.Float(
                 ...,
                 groups='account.group_account_invoice,account.group_account_readonly')

         Атрибут groups= на полі — це СПРАВЖНЯ перевірка доступу в ORM,
         а не просто приховування в інтерфейсі. Користувач без цих груп
         не може ні прочитати поле, ні змінити його.

         Наслідок: якби ми створили групу контролера БЕЗ бухгалтерських
         груп, контролер фізично не зміг би встановити ліміт — поле було б
         йому недоступне. Модуль «працював» би, але головна функція була б мертва.

         Тому група контролера успадковує group_account_invoice («Billing»).
         Це логічно й бізнесово: кредитний контролер — роль у фінансовому
         відділі, він і так працює з дебіторкою.

         Друге успадкування — sales_team.group_sale_salesman.
         Воно потрібне з іншої причини: схвалюючи запит, наш код пише
         повідомлення в chatter замовлення (message_post), а це операція
         ЗАПИСУ в sale.order. Без прав на продажі контролер отримав би
         AccessError у момент схвалення — і функція була б неробочою.
         ===================================================================== -->
    <record id="group_credit_controller" model="res.groups">
        <field name="name">Кредитна політика / Контролер</field>
        <field name="category_id" ref="techdistrib_base.module_category_techdistrib"/>
        <field name="implied_ids" eval="[
            (4, ref('techdistrib_base.group_dealer_user')),
            (4, ref('account.group_account_invoice')),
            (4, ref('sales_team.group_sale_salesman')),
        ]"/>
        <field name="comment">Схвалення перевищень кредитного ліміту, встановлення лімітів дилерам.</field>
    </record>

    <!-- =====================================================================
         2. ПРАВИЛА ЗАПИСІВ (ir.rule): хто які РЯДКИ бачить
         =====================================================================

         ⚠️ НАЙПІДСТУПНІША ТЕМА В БЕЗПЕЦІ ODOO. Розберемо уважно.

         Мета: менеджер із продажу бачить лише ТІ запити, які створив сам;
         кредитний контролер бачить УСІ.

         ЯК ODOO ОБ'ЄДНУЄ ПРАВИЛА (це не інтуїтивно!):
           * ГЛОБАЛЬНІ правила (без groups) — об'єднуються через AND.
             Вони застосовуються до всіх і лише ЗВУЖУЮТЬ доступ.
           * ПРАВИЛА ГРУП — об'єднуються через OR між собою.
             Користувач отримує доступ, якщо його пропускає ХОЧ ОДНЕ
             з правил його груп.

         ЗВІДСИ КЛАСИЧНА ПОМИЛКА, яку я ледь не зробив:
         якщо написати ЛИШЕ одне обмежувальне правило для
         group_dealer_user, то контролер — який теж входить у
         group_dealer_user (через implied_ids!) — потрапить під нього
         й побачить лише свої запити. Привілейована роль виявиться
         обмеженою.

         ПРАВИЛЬНИЙ ПАТЕРН — ДВА правила:
           1) обмежувальне для «менеджерів»;
           2) дозвільне (permissive) для привілейованої групи.
         Тоді в контролера OR дасть «бачу все», а у звичайного
         менеджера лишиться обмеження.

         Це стандартний прийом Odoo, і його варто запам'ятати.
         ===================================================================== -->

    <!-- 2.1. Менеджер бачить лише створені ним запити -->
    <record id="rule_credit_request_own" model="ir.rule">
        <field name="name">Кредитний запит: менеджер бачить лише свої</field>
        <field name="model_id" ref="model_techdistrib_credit_request"/>
        <!-- domain_force — домен, який Odoo ДОДАЄ до кожного запиту
             користувача. Доступні змінні:
                user             — поточний користувач (res.users)
                user.partner_id  — його партнер
                company_id / company_ids — доступні компанії
                time             — поточна дата/час
                uid              — id користувача
        -->
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('techdistrib_base.group_dealer_user'))]"/>
        <!-- ⚠️ Ставимо True для ВСІХ операцій.
             Якщо лишити perm_write=False, правило НЕ застосовуватиметься
             до запису — і менеджер зміг би редагувати чужі запити,
             хоча не бачив би їх у списку. Небезпечна непослідовність. -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 2.2. Контролер бачить усе — дозвільне правило.
         Домен [(1, '=', 1)] — це ідіома Odoo «завжди істина».
         Він «розчиняє» обмеження попереднього правила через OR. -->
    <record id="rule_credit_request_controller_all" model="ir.rule">
        <field name="name">Кредитний запит: контролер бачить усі</field>
        <field name="model_id" ref="model_techdistrib_credit_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_credit_controller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
