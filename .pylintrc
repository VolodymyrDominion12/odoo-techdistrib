; =============================================================================
;  .pylintrc — pylint + pylint-odoo для кастомних аддонів
; =============================================================================
;  Запуск:   ./scripts/lint.sh
;  Вручну:   .venv-lint/bin/pylint --rcfile=.pylintrc custom_addons
;
;  Плагін pylint_odoo знає про Odoo те, чого не знає звичайний pylint:
;  він перевіряє __manifest__.py, переклади, пошук без limit, застарілі
;  методи ORM. Саме тому він тут, а не «просто pylint».
;
;  Кожне вимкнення нижче має причину. Якщо причина зникне — правило
;  треба повернути, а не тримати вимкненим «бо так історично склалось».
; =============================================================================

[MAIN]
load-plugins=pylint_odoo
py-version=3.12
; jobs=1 — свідомо, а не «бо так швидше».
; jobs=0 означає «паралельно на всіх ядрах»: pylint піднімає ProcessPoolExecutor,
; який вимагає SemLock. У середовищах з обмеженим доступом до /dev/shm це падає
; з PermissionError — і замість звіту ти бачиш трейсбек у середині multiprocessing.
; Плюс: послідовний прогін дає стабільний порядок рядків, тож diff між прогонами
; читається. На 6 тисячах рядків різниця у швидкості не варта цих проблем.
jobs=1

[MESSAGES CONTROL]
; ПРО ПЕРЕВІРКИ Odoo 18, ЯКІ ВАРТО ЗНАТИ:
;
; OCA у своєму «обов'язковому» профілі (pylintrc-mandatory) вмикає частину
; перевірок ЛИШЕ для Odoo >= 19 — зокрема no-search-all, no-write-in-compute,
; prefer-env-translation, inheritable-method-*, deprecated-name-get,
; bad-builtin-groupby. Тобто типовий CI OCA на 18.0 їх не ганяє.
;
; Нам це не заважає: pylint-odoo 10 вмикає їх за замовчуванням, і перевірено,
; що на цьому проєкті вони справді працюють (саме так знайдено W8163 і W8120
; у res_partner.py). Дублювати їх списком `enable=` не потрібно — краще
; тримати перевірки увімкненими за замовчуванням, а вимикати точково нижче.
;
; Якщо колись знадобиться зафіксувати їх явно, ось повний набір із кодами:
;   E8102 invalid-commit            E8103 sql-injection
;   E8106 external-request-timeout  E8135 no-write-in-compute
;   E8146 deprecated-name-get       E8147 inheritable-method-string
;   E8148 inheritable-method-lambda E8149 deprecated-inselect-operator
;   W8106 method-required-super     W8113 attribute-string-redundant
;   W8155 bad-builtin-groupby       W8161 prefer-env-translation
;   W8163 no-search-all             W8164 super-method-mismatch
disable=

    ; --- Це НЕ модуль OCA, тому вимоги OCA до оформлення не діють ---
    manifest-required-author,   ; C8101 вимагає автора «Odoo Community Association (OCA)»
    missing-readme,             ; C8112 вимагає README.rst у розкладці OCA

    ; --- Свідомі рішення цього проєкту (це навчальний матеріал) ---
    manifest-deprecated-key,    ; C8103: `description` у маніфесті — тут це лекція, а не недогляд
    manifest-superfluous-key,   ; C8116: явний `installable: True` читається краще за неявність

    ; --- Хибні спрацьовування в контексті Odoo ---
    ; W8110: перевизначення `_compute_*` виставляє поля через `self.field = ...`;
    ;        `super()` у такому методі не повертає значення — і не має.
    missing-return,
    ; C0114/C0115/C0116: у цьому проєкті документація живе у трьох інших місцях —
    ;   * розгорнутий коментар над класом/методом (українською, з поясненням «чому»);
    ;   * `_description` у моделі — саме його Odoo показує в UI;
    ;   * `description` у маніфесті — текст для сторінки Apps.
    ; Вимога docstring-а додала б ЧЕТВЕРТЕ місце з тим самим змістом. Це не
    ; економія зусиль, а відмова від дублювання: розійтися можуть три джерела
    ; правди, а чотири — гарантовано розійдуться.
    missing-docstring,
    ; W0212: тести навмисно кличуть `_cron_*` і приватні хелпери — це їхня робота.
    protected-access,
    ; C0103: API unittest вимагає camelCase (`setUpClass`, `setUp`), це не порушення.
    invalid-name,
    ; R0904/R0903: клас тестів законно містить багато тестів; модель Odoo —
    ;             це дані плюс кілька методів, а не сервіс із десятьма.
    too-many-public-methods,
    too-few-public-methods,
    too-many-instance-attributes,
    ; R0801: маніфести й views структурно схожі за побудовою — це не дублювання логіки.
    duplicate-code,
    ; E0401/C0411: `odoo` не встановлений як пакет — він запускається з vendor/odoo.
    import-error,
    no-name-in-module,
    ; R0911/R0912/R0913/R0914: сітки параметрів і довгі методи у views-хелперах.
    too-many-return-statements,
    too-many-branches,
    too-many-locals,
    too-many-arguments,
    ; C0415: у тестах локальний імпорт psycopg2 читається краще.
    import-outside-toplevel,
    ; W0201: атрибут, виставлений у setUpClass, pylint не бачить як оголошений.
    attribute-defined-outside-init,
    ; C0209: .format() у повідомленнях — не привід для правки під час іншої задачі.
    consider-using-f-string,
    ; W0613: `_group_expand_*(self, states, domain)` — це КОНТРАКТ Odoo: рушій
    ;        кличе метод із двома аргументами, навіть якщо тіло їх не читає.
    ;        Прибрати їх = зламати групування в пошукових фільтрах.
    unused-argument,

    ; --- ЗАДОКУМЕНТОВАНИЙ БОРГ (не «вимкнено назавжди») ---------------------
    ; W8161 prefer-env-translation — 63 місця на момент написання цього файлу.
    ;
    ; Перевірка ПРАВИЛЬНА й актуальна для Odoo 18: тут з'явився self.env._(),
    ; який перекладає З УРАХУВАННЯМ МОВИ СЕРЕДОВИЩА (self.env.lang), а
    ; модульний `_()` бере поточну мову процесу. Для cron-задач і листів
    ; різниця реальна: партнер із uk_UA отримає український текст.
    ;
    ; Вимкнено СВІДОМО й ТИМЧАСОВО, а не як «шум». Масовий механічний
    ; перепис 63 рядків у 4 модулях — це окремий коміт зі своїм прогоном
    ; тестів, а не супутній ефект іншої задачі. Поки борг не закритий,
    ; перевірка лишається тут закоментованою: щоб побачити повний список,
    ; закоментуй рядок нижче й запусти ./scripts/lint.sh
    prefer-env-translation,

[REPORTS]
output-format=colorized
reports=no
score=yes

[FORMAT]
max-line-length=100

[DESIGN]
max-args=12
max-locals=25

[ODOOLINT]
; Тільки версії, які реально підтримує цей проєкт.
valid-odoo-versions=18.0
